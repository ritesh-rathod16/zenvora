# Environment Configuration (development / staging / production)
ENVIRONMENT=production

# Database (MongoDB Atlas)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/zenvora?retryWrites=true&w=majority
DATABASE_NAME=zenvora

# Authentication & Security
SECRET_KEY=generate_with_python_secrets_token_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Master Admin Account
ADMIN_EMAIL=admin@zenvora.app
ADMIN_PASSWORD=change_this_master_admin_password_in_production

# LiveKit Voice Room Credentials
LIVEKIT_URL=https://your-livekit-server-url.com
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ImageKit CDN Integration (Optional - Falls back to GridFS)
IMAGEKIT_PUBLIC_KEY=your_imagekit_public_key
IMAGEKIT_PRIVATE_KEY=your_imagekit_private_key
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_imagekit_id

# CORS Configuration
CORS_ORIGINS=https://zenvora.app,https://admin.zenvora.app

# Realtime & Redis Cache
REDIS_URL=redis://localhost:6379

# Email SMTP Setup (100% Free Tier Supported via Brevo/SMTP)
SMTP_SERVER=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your_smtp_login
SMTP_PASSWORD=your_smtp_password
EMAIL_FROM=notifications@zenvora.app
